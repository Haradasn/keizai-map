# Cloudflare(Workers の静的アセット)が全ページに付けるヘッダー。このファイル自体は配信されない。
# テスト(tests/test_site.py)のローカルサーバーも同じ内容を付けるので、CSP で壊れるページはテストで落ちる。
# 外部から読み込むのは: Google Fonts、Turnstile(反応の入力欄)、Cloudflare Web Analytics だけ。
# インラインの <script>(テーマ切り替え・グラフのデータ)があるため script-src に 'unsafe-inline' を残している。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
