{
  "name": "keizai-map",
  "private": true,
  "scripts": {
    "build": "python3 scripts/build_site.py && prettier --write --embedded-language-formatting=off --log-level=warn \"site/**/*.html\"",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o site/assets.css --minify",
    "format": "prettier --write pages/*.js worker/index.js pipeline/explorer_template.html pages/*.html && ruff format . && ruff check --fix .",
    "format:check": "prettier --check pages/*.js worker/index.js pipeline/explorer_template.html pages/*.html",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19",
    "daisyui": "4.12.24",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "axe-core": "4.14.0"
  },
  "dependencies": {
    "3d-force-graph": "1.73.4"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
