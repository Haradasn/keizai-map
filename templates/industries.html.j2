{# 産業一覧ページの本文。groups=[{color, name, sectors:[{id, name, output, industries:[{href, text}]}]}] #}
<main class="flex-1 w-full max-w-4xl mx-auto px-4 py-10 space-y-6">
<header class="space-y-3">
  <h1 class="text-3xl font-bold">産業一覧</h1>
  <p class="text-base-content/80">日本の産業を、8つの大分類・37の部門・108の産業に分けて、それぞれの規模と取引先を見られます。名前をクリックすると、その産業のページに移ります。数字は2020年の産業連関表です。</p>
</header>
{% for group in groups %}
<section class="space-y-2">
  <h2 class="text-xl font-bold flex items-center gap-2"><i style="display:inline-block;width:12px;height:12px;border-radius:50%;background:{{ group.color }}"></i>{{ group.name|esc }}</h2>
  {% for sector in group.sectors %}
  <div class="pl-2">
    <p><a class="link link-primary font-bold" href="industry/{{ sector.id }}.html">{{ sector.name|esc }}</a>
| <span class="text-xs text-base-content/60">{{ sector.output }}兆円</span></p>
    <p class="text-sm pl-4 text-base-content/80">
      {% for item in sector.industries %}<a class="link" href="{{ item.href }}">{{ item.text|esc }}</a>{{ "、" if not loop.last else "" }}{% endfor %}
    </p>
  </div>
  {% endfor %}
</section>
{% endfor %}
</main>
