{# 108産業の個別ページの本文。冒頭は、いちばん大きい行き先の一文と、出どころ・行き先の図 #}
{% from "_macros.html.j2" import ind_link, section, data_table %}
{% from "_charts.html.j2" import flow_figure, ruler_list, column_chart %}
<main class="flex-1 w-full max-w-4xl mx-auto px-4 py-8 space-y-10">⏎
<nav aria-label="パンくずリスト" class="text-sm breadcrumbs"><ul>
  <li><a href="industries.html">産業一覧</a></li>
  <li><a href="industry/{{ sector_id }}.html">{{ sector_name|esc }}</a></li>
  <li>{{ name|esc }}</li>
</ul></nav>⏎
<header class="space-y-3">
  <h1 class="ind-h1" style="--n:{{ name|length }}">{{ name|esc }}</h1>
  <p class="ind-lead">行き先の<b>{{ flow.top_share }}</b>%は、<span>{{ flow.top_label }}。</span></p>
  <p class="text-sm text-base-content/80">{% if flow.detail %}{{ flow.detail|esc }}{% endif %}{{ flow.base }}の内訳です。</p>
  {% if note %}<p class="text-sm">{{ note|esc }}</p>{% endif %}
</header>⏎
{{ flow_figure(flow, name, "産業") }}⏎
<p class="text-base-content/80">{{ facts }}</p>⏎
{% call section(count ~ "産業の中での位置") %}
  <p class="text-sm text-base-content/70">細い線が{{ count }}産業のそれぞれ、朱の線が{{ name|esc }}です。順位は、値の大きい順。</p>
  {{ ruler_list(rulers) }}
{% endcall %}⏎
<div class="ind-pair grid gap-10 md:grid-cols-2">⏎
{% call section("主な仕入れ先") %}
  {% if buy_rows %}{{ data_table(["仕入れ先の産業", "金額", "費用に占める割合"], buy_rows) }}{% else %}<p class="text-sm text-base-content/80">ほかの産業からの仕入れは、ほとんどありません。</p>{% endif %}
{% endcall %}⏎
{% call section("主な販売先") %}
  {% if sell_rows %}{{ data_table(["販売先の産業", "金額", "行き先に占める割合"], sell_rows) }}{% else %}<p class="text-sm text-base-content/80">ほかの産業が材料やサービスとして使う分は、ほとんどありません（行き先は上の図のとおり）。</p>{% endif %}
  {% if self_trade %}<p class="text-sm text-base-content/70">同じ産業の中の取引は{{ self_trade.amount }}（行き先の{{ self_trade.share }}）で、表には入れていません。</p>{% endif %}
{% endcall %}⏎
</div>⏎
{% if trend %}
  {% call section("規模の推移（実質）") %}
    <div class="ind-trend">
      {{ column_chart(trend.chart) }}
      <p class="text-sm text-base-content/80">数字は兆円（2020年価格）。2011→2015年は年{{ trend.growth_2011_2015 }}%、2015→2020年は年{{ trend.growth_2015_2020 }}%でした。</p>
    </div>
  {% endcall %}
{% endif %}⏎
{% if group %}
  {% call section("ブルーオーシャン候補グループの構成部門") %}
    <p class="text-sm text-base-content/80">筆者の仮説で、この産業は「{{ group.name|esc }}」（{{ group.id }}）の構成部門としています。くわしくは<a class="link" href="similarity.html">近さの地図</a>を参照してください。</p>
  {% endcall %}
{% endif %}⏎
{% call section("取引の相手が似ている産業") %}
  <p class="text-sm text-base-content/70">仕入れ先・販売先の構成が近い産業です（<a class="link" href="similarity.html">近さの地図</a>と同じ計算）。</p>
  <ul class="list-disc pl-6 text-sm">
    {% for item in neighbors %}
    <li>{{ ind_link(item.href, item.text) }}</li>
    {% endfor %}
  </ul>
{% endcall %}⏎
{% call section("同じ部門の産業") %}
  <p class="text-sm">
    {% for item in siblings %}{{ ind_link(item.href, item.text) }}{{ "、" if not loop.last else "" }}{% else %}なし{% endfor %}
  </p>
  <p class="text-sm text-base-content/80">部門全体の取引先と、この部門で稼ぐ県は、<a class="link" href="industry/{{ sector_id }}.html">{{ sector_name|esc }}（37部門）</a>のページへ。</p>
{% endcall %}⏎
<p class="text-xs text-base-content/70">出典：総務省ほか「産業連関表」（2011・2015・2020年、108部門）を筆者が集計。成長率は接続産業連関表による実質値。図の「その他の仕入れ」と「家計」には、企業の交際費・福利厚生費など（家計外消費支出）を含めています。政府が作成したものではありません。<a class="link" href="about.html">方法と出典</a></p>⏎
</main>
