{# 37部門の個別ページの本文。冒頭は、いちばん大きい行き先の一文と、出どころ・行き先の図 #}
{% from "_macros.html.j2" import ind_link, section, data_table %}
{% from "_charts.html.j2" import flow_figure, ruler_list %}
<main class="flex-1 w-full max-w-4xl mx-auto px-4 py-8 space-y-10">⏎
<nav aria-label="パンくずリスト" class="text-sm breadcrumbs"><ul>
  <li><a href="industries.html">産業一覧</a></li>
  <li>{{ group_name|esc }}</li>
  <li>{{ name|esc }}</li>
</ul></nav>⏎
<header class="space-y-3">
  <h1 class="ind-h1" style="--n:{{ name|length }}">{{ name|esc }}</h1>
  <p class="ind-lead">行き先の<b>{{ flow.top_share }}</b>%は、<span>{{ flow.top_label }}。</span></p>
  <p class="text-sm text-base-content/80">{% if flow.detail %}{{ flow.detail|esc }}{% endif %}{{ flow.base }}の内訳です。</p>
  {% if note %}<p class="text-sm">{{ note|esc }}</p>{% endif %}
</header>⏎
{{ flow_figure(flow, name, "部門") }}⏎
<p class="text-base-content/80">{% filter esc %}{% include "sector_facts.txt.j2" %}{% endfilter %}</p>⏎
{% call section(count ~ "部門の中での位置") %}
  <p class="text-sm text-base-content/70">細い線が{{ count }}部門のそれぞれ、朱の線が{{ name|esc }}です。順位は、値の大きい順。</p>
  {{ ruler_list(rulers) }}
{% endcall %}⏎
{% call section("含まれる産業（108産業）") %}{{ data_table(["産業", "産出額", "実質成長（2015→20年/年）"], sub_rows) }}{% endcall %}⏎
<div class="ind-pair grid gap-10 md:grid-cols-2">⏎
{% call section("主な仕入れ先") %}
  {% if buy_rows %}{{ data_table(["仕入れ先の部門", "金額", "費用に占める割合"], buy_rows) }}{% else %}<p class="text-sm text-base-content/80">ほかの部門からの仕入れは、ほとんどありません。</p>{% endif %}
{% endcall %}⏎
{% call section("主な販売先") %}
  {% if sell_rows %}{{ data_table(["販売先の部門", "金額", "行き先に占める割合"], sell_rows) }}{% else %}<p class="text-sm text-base-content/80">ほかの部門が材料やサービスとして使う分は、ほとんどありません（行き先は上の図のとおり）。</p>{% endif %}
  {% if self_trade %}<p class="text-sm text-base-content/70">同じ部門の中の取引は{{ self_trade.amount }}（行き先の{{ self_trade.share }}）で、表には入れていません。</p>{% endif %}
{% endcall %}⏎
</div>⏎
{% if kasegi or dense %}
  {% call section(name|esc ~ ("で稼ぐ県" if kasegi else "が集中している県")) %}
    {% if kasegi %}
    <p class="text-sm">{{ name|esc }}が<a class="link" href="kasegi-map.html">稼ぎ頭</a>（県外・海外にいちばん多く売っている部門）の県は、{% for p in kasegi %}{{ ind_link(p.href, p.text) }}（{{ p.value }}）{{ "、" if not loop.last else "" }}{% endfor %}です。かっこ内は、その県が県外・海外に売る額に占める割合。</p>
    {% endif %}
    {% if dense %}
    <p class="text-sm">全国平均と比べて集中している県は、{% for p in dense %}{{ ind_link(p.href, p.text) }}（{{ p.value }}）{{ "、" if not loop.last else "" }}{% endfor %}です。かっこ内は、産出額に占める割合が全国平均の何倍か。</p>
    {% endif %}
    <p class="text-xs text-base-content/70">各都道府県が公表した2020年の産業連関表を、筆者が同じ37部門にそろえて集計（{{ pref_count }}都道府県）。<a class="link" href="prefecture-map.html?k={{ id }}">県別の分布を立体地図で見る</a></p>
  {% endcall %}
{% endif %}⏎
{% if stories %}
  {% call section("取引のストーリー（筆者の仮説）") %}
    <p class="text-sm text-base-content/70">主な取引のうち、背景を読み解いたもの。統計から確定できる事実ではありません。</p>
    {% for s in stories %}
    <div class="card bg-base-100 border border-base-300"><div class="card-body p-4 gap-1">
      <b>{{ s.source|esc }} → {{ s.target|esc }}（{{ s.value }}兆円）<span class="badge badge-outline badge-sm ml-2">確度{{ s.confidence|esc }}</span></b>
      <p class="text-sm">{{ s.story|esc }}</p>
      <p class="text-xs text-base-content/70">根拠の目安：{{ s.basis|esc }}</p>
      <p><button type="button" class="link link-primary text-xs" data-hyp="{{ s.source|esc }}→{{ s.target|esc }}">この仮説に補足・反論を送る</button></p>
    </div></div>
    {% endfor %}
  {% endcall %}
{% endif %}⏎
<p class="text-sm"><a class="btn btn-sm btn-outline" href="explorer.html?sel={{ id }}">産業マップで{{ name|esc }}の取引を見る</a></p>⏎
<p class="text-xs text-base-content/70">出典：総務省ほか「産業連関表」（2011・2015・2020年）、経済産業省「延長産業連関表」を筆者が集計。産出額と取引は2020年の基本表、成長率は3時点で部門の範囲をそろえた接続産業連関表によるため、範囲が少し違う部門があります（運輸・郵便の成長率は自家輸送を含まない、など）。図の「その他の仕入れ」と「家計」には、企業の交際費・福利厚生費など（家計外消費支出）を含めています。政府が作成したものではありません。<a class="link" href="about.html">方法と出典</a></p>⏎
</main>
