{# 読者の反応の欄。sitekey が空のあいだは base から呼ばれない #}
<section id="fb" aria-label="読者の反応" class="max-w-3xl mx-auto w-full px-4 mt-12" data-sitekey="{{ sitekey }}">
<div class="rounded-box border border-base-300 bg-base-100 p-5 space-y-3">⏎
<div class="flex flex-wrap items-center gap-3">
  <p class="font-bold">このページは役に立ちましたか？</p>
  <button id="fb-like" type="button" class="btn btn-sm btn-outline">👍 役に立った</button>
  <span id="fb-like-msg" class="text-sm text-base-content/70" aria-live="polite"></span>
</div>⏎
<details id="fb-req">
  <summary class="cursor-pointer text-sm link link-primary">「こんな情報が欲しい」を送る</summary>⏎
<form id="fb-form" class="mt-3 space-y-2">
  <p id="fb-about" class="text-sm rounded-box bg-base-200 p-3" hidden></p>
  <label for="fb-body" class="text-sm block">知りたいこと、見てみたい統計、気づいた誤りなど（500字まで）</label>
  <textarea id="fb-body" maxlength="500" rows="3" class="textarea textarea-bordered w-full" required></textarea>
  <div id="fb-ts"></div>⏎
<div class="flex items-center gap-3">
  <button class="btn btn-sm btn-primary" type="submit">送信</button>
  <span id="fb-msg" class="text-sm" aria-live="polite"></span>
</div>⏎
<p class="text-xs text-base-content/70">名前やメールアドレスは不要です。保存するのは送信内容とページ名だけで、IPアドレスなどは保存しません。個別の返信はできません。</p></form></details>⏎
</div></section>
<script src="/feedback.js" defer></script>⏎
